# Railway will inject DATABASE_URL automatically when you attach a Postgres resource.
# For local development, copy this file to .env and fill in your own connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lakay

# Change this secret before deploying.
JWT_SECRET=super-secret-change-me

# Optional: adjust port if Railway assigns one via PORT env.
PORT=4000

# Email settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=admin@lakay.social
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
